generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AuditActorType {
  ADMIN
  MCP_CLIENT
  SYSTEM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String
  status  Status @default(DRAFT)

  // Case study
  problem  String?
  approach String?
  solution String?
  results  String?

  // Short, card-safe outcome. `results` is long-form prose that truncates badly
  // in listings, so cards render `outcome` (one complete claim) with
  // `outcomeContext` carrying the measurement basis that keeps it honest.
  outcome        String?
  outcomeContext String?

  client      String?
  role        String?
  timeline    String?
  techStack   String[]
  keyFeatures String[] @default([])
  liveUrl     String?
  githubUrl   String?

  gallery Asset[]

  order    Int     @default(0)
  featured Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Post {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  excerpt      String
  content      String
  status       Status  @default(DRAFT)
  featured     Boolean @default(false)
  version      Int     @default(1)
  coverImage   Asset?  @relation("PostCoverImage", fields: [coverImageId], references: [id])
  coverImageId String? @unique

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Asset {
  id     String  @id @default(cuid())
  key    String  @unique
  url    String
  alt    String?
  width  Int?
  height Int?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
  postCover Post?    @relation("PostCoverImage")

  createdAt DateTime @default(now())

  @@index([projectId])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String
  actorType  AuditActorType
  clientId   String?
  toolName   String?
  action     String
  targetType String
  targetId   String
  requestId  String         @unique
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// OAuth 2.1 authorization server for remote MCP clients.
// Google is the login step; this server is the token issuer, so access tokens
// carry this site's audience and scopes instead of Google's.
// ---------------------------------------------------------------------------

model OAuthClient {
  id                      String   @id @default(cuid())
  name                    String
  secretHash              String?
  redirectUris            String[]
  grantTypes              String[]
  scopes                  String[]
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now())

  authorizations OAuthAuthorization[]
  refreshTokens  OAuthRefreshToken[]
}

model OAuthAuthorization {
  id       String      @id @default(cuid())
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  redirectUri         String
  scopes              String[]
  resource            String?
  clientState         String?
  codeChallenge       String
  codeChallengeMethod String
  approvalNonce       String

  codeHash   String?   @unique
  subject    String?
  email      String?
  name       String?
  approvedAt DateTime?
  consumedAt DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OAuthRefreshToken {
  id       String      @id @default(cuid())
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  tokenHash String  @unique
  subject   String
  email     String?
  name      String?
  scopes    String[]
  resource  String?

  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([subject])
  @@index([expiresAt])
}
