# Neon Postgres — Connection Details in the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 — R2 dashboard > bucket + API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-public-r2-domain>

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Seeded admin login (single admin user, hashed by prisma/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Scheduled post publishing — shared secret for the GitHub Actions cron workflow.
# Also set SITE_URL and CRON_SECRET as repo secrets in GitHub (Settings > Secrets > Actions).
CRON_SECRET=

# Minions AI auto-publishing webhook secret (Bearer token)
MINIONS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Remote MCP server (mcp.parvejshah.com)
# This deployment is both the OAuth 2.1 authorization server and the MCP
# resource server. Google is only the login step.
# ---------------------------------------------------------------------------

# Public origin of the MCP deployment. Every OAuth endpoint, the JWT issuer, and
# the token audience (<origin>/mcp) are derived from this single value.
MCP_PUBLIC_URL=https://mcp.parvejshah.com

# RS256 signing key for MCP access tokens (PKCS#8 PEM, or the same PEM base64-encoded).
# Generate with: npm run mcp:keygen
MCP_JWT_PRIVATE_KEY=

# Google OAuth client used to sign the owner in.
# Authorized redirect URI: <MCP_PUBLIC_URL>/oauth/callback
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=

# Single-owner allowlist. Signing in with Google proves identity; this decides
# who is actually allowed to manage the site. Set at least one.
MCP_ALLOWED_EMAIL=
MCP_ALLOWED_SUBJECT=

# Google reCAPTCHA v2 Checkbox
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cal.com link (e.g. xpeedlab/30min)
NEXT_PUBLIC_CAL_LINK=parvejshah/15min
